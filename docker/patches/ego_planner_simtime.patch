diff --git a/src/planner/traj_utils/include/traj_utils/ego_clock.hpp b/src/planner/traj_utils/include/traj_utils/ego_clock.hpp
new file mode 100644
index 0000000..55a1f69
--- /dev/null
+++ b/src/planner/traj_utils/include/traj_utils/ego_clock.hpp
@@ -0,0 +1,23 @@
+#ifndef _EGO_CLOCK_HPP_
+#define _EGO_CLOCK_HPP_
+
+#include <memory>
+#include <rclcpp/rclcpp.hpp>
+
+namespace ego_planner
+{
+  // Clock for trajectory start times, trajectory evaluation and timeouts. Each executable sets it to its node's
+  // clock, so with use_sim_time the planner follows simulation time. Until then it is a plain ROS clock
+  // (system time), which keeps the clock type equal to that of times read from messages.
+  inline rclcpp::Clock::SharedPtr &egoClockStorage()
+  {
+    static rclcpp::Clock::SharedPtr clock = std::make_shared<rclcpp::Clock>(RCL_ROS_TIME);
+    return clock;
+  }
+
+  inline void setEgoClock(const rclcpp::Clock::SharedPtr &clock) { egoClockStorage() = clock; }
+
+  inline rclcpp::Time egoNow() { return egoClockStorage()->now(); }
+} // namespace ego_planner
+
+#endif
