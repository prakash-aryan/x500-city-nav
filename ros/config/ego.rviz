Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Ego-Planner1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Cell Size: 1
      Plane Cell Count: 40
      Normal Cell Count: 0
      Plane: XY
      Reference Frame: odom
      Value: true
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.6
      Name: Drone (base_link)
      Radius: 0.08
      Reference Frame: base_link
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Name: Drone Model (X500)
      Visual Enabled: true
      Value: true
    - Ceiling Height: 2.2
      Class: nvblox_rviz_plugin/NvbloxMesh
      Cut Ceiling: true
      Enabled: true
      Mesh Color: Color
      Name: Nvblox 3D Mesh
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /nvblox_node/mesh
      Value: true
    - Class: rviz_common/Group
      Name: Ego-Planner
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/Marker
          Enabled: true
          Name: Trajectory
          Namespaces:
            {}
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /optimal_list
          Value: true
        - Class: rviz_default_plugins/Marker
          Enabled: true
          Name: Goal
          Namespaces:
            {}
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /goal_point
          Value: true
        - Alpha: 0.4
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 3
            Min Value: 0
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 90; 0
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: Obstacles (occupancy)
          Position Transformer: XYZ
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.10000000149011612
          Style: Boxes
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /grid_map/occupancy_inflate
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Camera (color)
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /quadrotor/camera/rgb
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Wind (on drone)
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /wind/arrow
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Wind field
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /wind/field
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 26
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: -3
        Y: 6
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.0
      Target Frame: odom
      Value: Orbit (rviz)
      Yaw: 1.5
    Saved: ~
Window Geometry:
  Camera (color):
    collapsed: false
  Displays:
    collapsed: false
  Height: 900
  Width: 1500
  Views:
    collapsed: false
