+# Isaac Sim 6.0 bug: SimulationContext._on_post_physics_ready re-subscribes every physics callback through one
+# loop variable, collapsing them all onto the last one after each world.reset(). Re-bind per callback so the
+# vehicle state/update/sensor callbacks keep firing. Patch the class before any World is created.
+def _pegasus_on_post_physics_ready(self, event):
+    for _name, _fn in self._physics_functions.items():
+        self._physics_callback_functions[_name] = (
+            self._physics_context._physics_sim_interface.subscribe_physics_on_step_events(
+                pre_step=True, order=0,
+                on_update=(lambda fn: (lambda step_dt, context: fn(step_dt)))(_fn),
+            )
+        )
+
+
+SimulationContext._on_post_physics_ready = _pegasus_on_post_physics_ready
+
